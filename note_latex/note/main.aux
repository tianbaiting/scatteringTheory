\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces \textbf  {左上}: $d^{1/2}_{m'm}(\theta )$ 的四个分量（解析式 $\pm \cos (\theta /2),\,\pm \sin (\theta /2)$）。\textbf  {右上}: $d^{1}_{m'm}(\theta )$ 的九个分量；中心元 $d^1_{00}=\cos \theta $、对角 $d^1_{\pm 1,\pm 1}=(1\pm \cos \theta )/2$。\textbf  {左下}: 在固定 $(m',m)=(1,0)$ 下，对 $j_1,j_2\in \{1,2,3,4\}$ 的内积矩阵热图，仅对角非零、值依次为 $\tfrac  {2}{2j+1}=\{2/3,2/5,2/7,2/9\}$，与解析公式偏差 $\sim 2\times 10^{-16}$。\textbf  {右下}: 玩具螺度振幅 $\mathrm  {Re}\,S/|S|$ 关于方位角 $\varphi $（$\theta =\pi /3$ 固定），三条曲线的相位斜率拟合给出 $\Delta \lambda =0,1,2$，与黑色虚线 $\cos (\Delta \lambda \varphi )$ 完全重合。}}{147}{figure.8.1}\protected@file@percent }
\newlabel{fig:numexp-ch06}{{8.1}{147}{\textbf {左上}: $d^{1/2}_{m'm}(\theta )$ 的四个分量（解析式 $\pm \cos (\theta /2),\,\pm \sin (\theta /2)$）。\textbf {右上}: $d^{1}_{m'm}(\theta )$ 的九个分量；中心元 $d^1_{00}=\cos \theta $、对角 $d^1_{\pm 1,\pm 1}=(1\pm \cos \theta )/2$。\textbf {左下}: 在固定 $(m',m)=(1,0)$ 下，对 $j_1,j_2\in \{1,2,3,4\}$ 的内积矩阵热图，仅对角非零、值依次为 $\tfrac {2}{2j+1}=\{2/3,2/5,2/7,2/9\}$，与解析公式偏差 $\sim 2\times 10^{-16}$。\textbf {右下}: 玩具螺度振幅 $\mathrm {Re}\,S/|S|$ 关于方位角 $\varphi $（$\theta =\pi /3$ 固定），三条曲线的相位斜率拟合给出 $\Delta \lambda =0,1,2$，与黑色虚线 $\cos (\Delta \lambda \varphi )$ 完全重合。}{figure.8.1}{}}

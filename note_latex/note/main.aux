\newlabel{fig:numexp-ch00}{{1.1}{20}{$|\psi (x,t)|^{2}$ 在 $t=0,5,10,15$ 的快照. 波包中心严格沿 $\langle x\rangle _{t}=x_{0}+p_{0}t$ 平移, 同时高度下降、宽度增大——这就是``自由弥散''}{figure.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces $\Delta x(t)$, $\Delta p(t)$ 与乘积 $\Delta x\,\Delta p$ 随时间的变化. 灰色虚线为 Heisenberg 下界 $1/2$. 数值结果显示 $\Delta p$ 严格守恒 (因为 $[\hat  {H}_{0},\hat  {p}]=0$), $\Delta x$ 渐近线性增长, 乘积初值正好饱和 $1/2$ 后单调上升.}}{21}{figure.1.2}\protected@file@percent }
\newlabel{fig:numexp-ch00-uncert}{{1.2}{21}{$\Delta x(t)$, $\Delta p(t)$ 与乘积 $\Delta x\,\Delta p$ 随时间的变化. 灰色虚线为 Heisenberg 下界 $1/2$. 数值结果显示 $\Delta p$ 严格守恒 (因为 $[\Op H_{0},\Op p]=0$), $\Delta x$ 渐近线性增长, 乘积初值正好饱和 $1/2$ 后单调上升}{figure.1.2}{}}

\@writefile{lol}{\contentsline {lstlisting}{\numberline {12.1}\texttt  {code/ch10\_numerov\_phase.py}}{247}{lstlisting.12.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces Numerov 法对吸引方势阱 $V(r)=-V_0\,\theta (a-r)$ （单位 ${\mathchar "AF\mkern -9muh}=2m=a=1$）的 $s$、$p$ 波相移与截面。 (A) $V_0=1,4,9,16$ 时的 $\delta _0(k)$（解 $\bmod  \pi $ 后用 \texttt  {np.unwrap} 连续化）。$V_0=1<(\pi /2)^2\approx 2.467$ 时无 $s$ 波束缚态，$\delta _0(0)=0$；$V_0=4,9,16$ 均处于 $((\pi /2)^2,(3\pi /2)^2)$ 之间故各有 $1$ 个 $s$ 波束缚态， $\delta _0(0)\to \pi $，与 Levinson 定理 $\delta _0(0)=n_0\pi $ （$n_0$ 为 $s$ 波束缚态数）一致。 (B) 散射长度 $a_0=-\lim _{k\to 0}\tan \delta _0(k)/k$ 作为 $V_0$ 的函数；图中两条灰虚线 $V_c=(\pi /2)^2,(3\pi /2)^2$ 处 $a_0$ 发散，对应零能束缚态新出现的阈值。 (C) $V_0=4$ 时分波截面 $\sigma _\ell (k)=(4\pi /k^2)(2\ell +1)\sin ^2\delta _\ell (k)$ （对数刻度）；低能区 $\sigma _0\propto a_0^2$ 占主导， $\sigma _1$ 由 $k^4$ 阈值压低。 (D) $V_0=4$ 时 Numerov 数值（蓝点）与解析公式 $\tan (ka+\delta _0)=(k/K)\tan (Ka)$，$K=\sqrt  {k^2+V_0}$ （橙线，主值分支）的逐点对比。}}{251}{figure.12.1}\protected@file@percent }
\newlabel{fig:numexp-ch10}{{12.1}{251}{Numerov 法对吸引方势阱 $V(r)=-V_0\,\theta (a-r)$ （单位 $\hbar =2m=a=1$）的 $s$、$p$ 波相移与截面。 (A) $V_0=1,4,9,16$ 时的 $\delta _0(k)$（解 $\bmod \pi $ 后用 \texttt {np.unwrap} 连续化）。$V_0=1<(\pi /2)^2\approx 2.467$ 时无 $s$ 波束缚态，$\delta _0(0)=0$；$V_0=4,9,16$ 均处于 $((\pi /2)^2,(3\pi /2)^2)$ 之间故各有 $1$ 个 $s$ 波束缚态， $\delta _0(0)\to \pi $，与 Levinson 定理 $\delta _0(0)=n_0\pi $ （$n_0$ 为 $s$ 波束缚态数）一致。 (B) 散射长度 $a_0=-\lim _{k\to 0}\tan \delta _0(k)/k$ 作为 $V_0$ 的函数；图中两条灰虚线 $V_c=(\pi /2)^2,(3\pi /2)^2$ 处 $a_0$ 发散，对应零能束缚态新出现的阈值。 (C) $V_0=4$ 时分波截面 $\sigma _\ell (k)=(4\pi /k^2)(2\ell +1)\sin ^2\delta _\ell (k)$ （对数刻度）；低能区 $\sigma _0\propto a_0^2$ 占主导， $\sigma _1$ 由 $k^4$ 阈值压低。 (D) $V_0=4$ 时 Numerov 数值（蓝点）与解析公式 $\tan (ka+\delta _0)=(k/K)\tan (Ka)$，$K=\sqrt {k^2+V_0}$ （橙线，主值分支）的逐点对比。}{figure.12.1}{}}
